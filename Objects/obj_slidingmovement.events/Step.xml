<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<event category="STEP" id="0">
  <actions>
    <action id="603" library="1">
      <!--action name: Code-->
      <kind>CODE</kind>
      <allowRelative>false</allowRelative>
      <question>false</question>
      <canApplyTo>true</canApplyTo>
      <actionType>CODE</actionType>
      <functionName/>
      <relative>false</relative>
      <not>false</not>
      <appliesTo>.self</appliesTo>
      <arguments>
        <argument kind="STRING">//Moves screen with the mouse
if instance_exists(obj_camera)
or instance_exists(obj_jumpscare)
    exit
if mouse_x &gt; view_wview[0]-50
    x += 40
else if mouse_x &lt; view_xview[0]+50
    x -= 40
else
    x = view_xview[0]+320
</argument>
      </arguments>
    </action>
  </actions>
</event>
